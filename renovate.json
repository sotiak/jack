{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": { "enabled": true },
  "lockFileMaintenance": { "enabled": true },
  "customManagers": [
    {
      "customType": "regex",
      "description": "BIZ UD Gothic release zip",
      "managerFilePatterns": ["/^assets\\/sources\\.toml$/"],
      "matchStrings": [
        "\\[biz\\]\\ntag = \"(?<currentValue>[^\"]+)\"\\nsha256 = \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "autoReplaceStringTemplate": "[biz]\ntag = \"{{{newValue}}}\"\nsha256 = \"{{{newDigest}}}\"",
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "googlefonts/morisawa-biz-ud-gothic",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Nerd Fonts symbols-only release",
      "managerFilePatterns": ["/^assets\\/sources\\.toml$/"],
      "matchStrings": [
        "\\[nerd\\]\\ntag = \"(?<currentValue>[^\"]+)\"\\nsha256 = \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "autoReplaceStringTemplate": "[nerd]\ntag = \"{{{newValue}}}\"\nsha256 = \"{{{newDigest}}}\"",
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    { "matchManagers": ["custom.regex"], "groupName": "font inputs" }
  ]
}
